@page
@inject PresentationModeOptions Presentation
@inject IPresentationDataProvider Demo
@inject IControlPlaneQueries Queries
@inject IPortalScopeAccessor ScopeAccessor
@{
    ViewData["Title"] = "Projetos";
    var ct = HttpContext.RequestAborted;
    IReadOnlyList<ProjectSummary> projects = Presentation.Enabled
        ? Demo.GetProjects()
        : await Queries.ListProjectsAsync(ScopeAccessor.Resolve(User), ct);
    var header = new PageHeaderModel("Projetos", "Cada projeto reúne a configuração de destino, as ondas de migração e a cadeia de custódia correspondente.");
}

<partial name="_PageHeader" model="header" />

@if (projects.Count == 0)
{
    var empty = new EmptyStateModel(
        "Nenhum projeto encontrado",
        "Um projeto define o tenant de destino, a política de arquivamento e o versionamento de configuração. Quando houver projetos neste escopo, eles aparecerão aqui.",
        "projects");
    <partial name="_EmptyState" model="empty" />
}
else
{
    <div class="tablewrap">
        <table class="data">
            <thead>
                <tr><th>Nome</th><th>Status</th><th>Tenant de destino</th><th>Política de archive</th><th>Config.</th><th>Última atualização</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var project in projects)
                {
                    <tr>
                        <td><b>@project.Name</b><div class="subtle">@project.Owner</div></td>
                        <td><partial name="_StatusBadge" model="project.Status" /></td>
                        <td class="mono">@project.TargetTenant</td>
                        <td class="muted">Retenção padrão</td>
                        <td>v@(project.ConfigurationVersion)</td>
                        <td class="mono nowrap">@DisplayFormat.Utc(project.UpdatedAtUtc)</td>
                        <td class="nowrap">
                            <a class="btn sm" asp-page="/Projects/Details" asp-route-projectId="@project.ProjectId">Ver Projeto</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
