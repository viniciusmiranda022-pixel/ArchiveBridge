@page
@model ArchiveBridge.ControlPlane.Pages.Evidence.IndexModel
@{
    ViewData["Title"] = "Evidências";
    var header = new PageHeaderModel("Evidências", "Histórico imutável dos artefatos e resultados produzidos pela plataforma. Cada linha é sustentada por hashes autoritativos e um download verificado byte a byte.");
}

<partial name="_PageHeader" model="header" />

<div class="alert info">
    <span class="a-ico">@Icons.Svg("shield")</span>
    <div class="a-body">
        <strong>Download verificado.</strong>
        Antes de entregar o artefato, o portal resolve a evidência no tenant/projeto autenticado, confere caminho lógico, tamanho e SHA-256 contra o registro e audita a leitura. Qualquer divergência bloqueia o download.
    </div>
</div>

<form method="get" class="filters">
    <div class="field">
        <label for="site">Site (prefixo)</label>
        <input id="site" name="site" value="@Model.SiteFilter" maxlength="100" autocomplete="off" />
    </div>
    <div class="field">
        <label for="env">Environment ID</label>
        <input id="env" name="env" value="@Model.EnvironmentFilter" autocomplete="off" />
    </div>
    <div class="field">
        <label for="result">Resultado</label>
        <select id="result" name="result">
            <option value="">Todos</option>
            @foreach (var status in new[] { "Ready", "Blocked", "Unsupported", "Failed" })
            {
                if (Model.ResultStatusFilter == status)
                {
                    <option value="@status" selected>@status</option>
                }
                else
                {
                    <option value="@status">@status</option>
                }
            }
        </select>
    </div>
    <div class="field">
        <label for="from">De (UTC)</label>
        <input id="from" name="from" value="@Model.FromFilter" placeholder="AAAA-MM-DDTHH:MM" autocomplete="off" />
    </div>
    <div class="field">
        <label for="to">Até (UTC)</label>
        <input id="to" name="to" value="@Model.ToFilter" placeholder="AAAA-MM-DDTHH:MM" autocomplete="off" />
    </div>
    <div class="field">
        <label for="size">Quantidade</label>
        <select id="size" name="size">
            @foreach (var size in new[] { 25, 50, 100 })
            {
                if (Model.PageSize == size)
                {
                    <option value="@size" selected>@size</option>
                }
                else
                {
                    <option value="@size">@size</option>
                }
            }
        </select>
    </div>
    <div class="field actions">
        <button type="submit" class="btn primary">@Icons.Svg("search") Filtrar</button>
        <a class="btn" asp-page="/Evidence/Index">Limpar</a>
    </div>
</form>

@if (Model.Items.Count == 0)
{
    var empty = new EmptyStateModel(
        "Nenhuma evidência disponível",
        "Cada execução madura de descoberta produz um artefato de evidência imutável. Quando houver evidências neste projeto, elas aparecerão aqui com hash e download verificado.",
        "evidence");
    <partial name="_EmptyState" model="empty" />
}
else
{
    <div class="tablewrap">
        <table class="data">
            <thead>
                <tr>
                    <th>Data (UTC)</th><th>Origem</th><th>Versão</th><th>Resultado</th><th>Ciclo de vida</th>
                    <th>SHA-256</th><th>Tamanho</th><th>Ação</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td class="mono nowrap">@DisplayFormat.Utc(item.CompletedAtUtc)</td>
                        <td><b>@item.SiteName</b></td>
                        <td>v@(item.DiscoveryVersion)</td>
                        <td><partial name="_StatusBadge" model="item.ResultStatus" /></td>
                        <td><partial name="_StatusBadge" model="item.LifecycleStatus" /></td>
                        <td><partial name="_HashDisplay" model="@(new HashModel(item.ContentSha256, 10))" /></td>
                        <td class="num">@DisplayFormat.HumanBytes(item.EvidenceSizeBytes)</td>
                        <td class="nowrap">
                            <a class="btn sm" asp-page="/Evidence/Download"
                               asp-route-environmentId="@item.EnvironmentId"
                               asp-route-version="@item.DiscoveryVersion">@Icons.Svg("download") Baixar Evidência</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="pager">
        <span class="count">Mostrando até @Model.PageSize registros.</span>
        @if (Model.HasMore)
        {
            <a class="btn sm" asp-page="/Evidence/Index" asp-all-route-data="@Model.NextPageRoute">Próxima →</a>
        }
    </div>
}
