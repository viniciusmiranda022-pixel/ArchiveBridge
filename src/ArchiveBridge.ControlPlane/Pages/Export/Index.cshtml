@page
@{
    ViewData["Title"] = "Exportação";
    var header = new PageHeaderModel("Exportação do Enterprise Vault", "Preparação e execução da exportação controlada — planejada para uma etapa futura.");
}

<partial name="_PageHeader" model="header" />

<div class="alert warning">
    <span class="a-ico">@Icons.Svg("clock")</span>
    <div class="a-body"><strong>Planejado — não disponível nesta versão.</strong>Esta área é intencionalmente inoperante: o portal não simula funcionalidades inexistentes.</div>
</div>

<div class="card-grid">
    <div class="card">
        <div class="card-head"><h3>Exportação de arquivos</h3><span class="badge warning"><span class="dot"></span>Planejado</span></div>
        <div class="card-body"><p class="muted mt0">Seleção de arquivos, preparação de lotes e acompanhamento de execução — sustentados por evidência.</p></div>
    </div>
    <div class="card">
        <div class="card-head"><h3>Importação Microsoft 365</h3><span class="badge neutral"><span class="dot"></span>Não disponível</span></div>
        <div class="card-body"><p class="muted mt0">Ingestão nos arquivos online do Microsoft 365 — etapa posterior do roteiro.</p></div>
    </div>
    <div class="card">
        <div class="card-head"><h3>Reconciliação</h3><span class="badge warning"><span class="dot"></span>Planejado</span></div>
        <div class="card-body"><p class="muted mt0">Reconciliação final e homologação contra o ambiente de origem.</p></div>
    </div>
</div>
