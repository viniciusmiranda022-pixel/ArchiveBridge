@page
@inject PresentationModeOptions Presentation
@inject IPresentationDataProvider Demo
@inject IControlPlaneQueries Queries
@inject IPortalOperationalAudit OperationalAudit
@inject IPortalScopeAccessor ScopeAccessor
@{
    ViewData["Title"] = "Visão Geral";
    var ct = HttpContext.RequestAborted;
    DashboardViewModel vm;
    if (Presentation.Enabled)
    {
        vm = Demo.GetDashboard();
    }
    else
    {
        var scope = ScopeAccessor.Resolve(User);
        var summary = await Queries.GetDashboardAsync(scope, ct);
        var recent = await OperationalAudit.RecentAsync(scope, 8, ct);
        vm = RealDashboardComposer.Build(summary, recent);
    }

    string MetricIcon(string key) => key switch
    {
        "projects" => "projects",
        "waves" => "waves",
        "environments" => "vault",
        "jobs" => "jobs",
        "evidence" => "evidence",
        "validations" => "clipboard-check",
        _ => "layers",
    };

    var header = new PageHeaderModel("Visão Geral", "Acompanhe o estado operacional da migração e os principais indicadores do projeto.");
}

<partial name="_PageHeader" model="header" />

<div class="metrics">
    @foreach (var metric in vm.Metrics)
    {
        <div class="metric">
            <div class="top">
                <span class="label">@metric.Label</span>
                <span class="chip-ico">@Icons.Svg(MetricIcon(metric.Key))</span>
            </div>
            <div class="value @(metric.Available ? null : "muted")">@metric.Value</div>
            @if (!metric.Available)
            {
                <span class="hint">Sem contagem nesta versão</span>
            }
        </div>
    }
</div>

<h2 class="section">Pipeline de Migração</h2>
<partial name="_Pipeline" model="vm.Pipeline" />

<div class="grid-status-activity">
    <div class="card">
        <div class="card-head"><h3>Status da Plataforma</h3></div>
        <div class="card-body">
            <div class="statuslist">
                @foreach (var component in vm.Platform)
                {
                    <div class="statusrow">
                        <div class="sname">@component.Name<small>@component.Detail</small></div>
                        <span class="badge @component.BadgeVariant"><span class="dot"></span>@component.Label</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-head"><h3>Atividade recente</h3></div>
        <div class="card-body flush">
            @if (vm.Activity.Count == 0)
            {
                var emptyActivity = new EmptyStateModel(
                    "Sem atividade registrada",
                    "As ações operacionais realizadas na plataforma aparecerão aqui.",
                    "clock");
                <partial name="_EmptyState" model="emptyActivity" />
            }
            else
            {
                <div class="tablewrap">
                    <table class="data">
                        <thead>
                            <tr><th>Hora (UTC)</th><th>Evento</th><th>Recurso</th><th>Resultado</th><th>Usuário</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in vm.Activity)
                            {
                                <tr>
                                    <td class="mono nowrap">@DisplayFormat.Utc(entry.WhenUtc)</td>
                                    <td>@entry.Event</td>
                                    <td class="mono">@entry.Resource</td>
                                    <td>
                                        @if (entry.Succeeded == true)
                                        {
                                            <span class="badge success"><span class="dot"></span>Sucesso</span>
                                        }
                                        else if (entry.Succeeded == false)
                                        {
                                            <span class="badge danger"><span class="dot"></span>Negado</span>
                                        }
                                        else
                                        {
                                            <span class="badge neutral"><span class="dot"></span>—</span>
                                        }
                                    </td>
                                    <td>@entry.Actor</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
