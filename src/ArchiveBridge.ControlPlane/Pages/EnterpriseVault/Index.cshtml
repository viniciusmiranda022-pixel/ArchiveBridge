@page
@model ArchiveBridge.ControlPlane.Pages.EnterpriseVault.IndexModel
@functions {
    static string PillClass(string? resultStatus) => resultStatus switch
    {
        "Ready" => "pill ok",
        "Blocked" => "pill bad",
        "Unsupported" => "pill warn",
        "Failed" => "pill bad",
        _ => "pill",
    };
}
@{
    ViewData["Title"] = "Enterprise Vault";
}
<h1>Enterprise Vault — descoberta de capacidades</h1>
<p class="lead">
    Resultado <span class="pill ok">Ready</span> / <span class="pill bad">Blocked</span> /
    <span class="pill warn">Unsupported</span> por ambiente, sempre sustentado por evidência. Descoberta é
    <strong>READ-ONLY</strong>: nenhuma exportação é executada.
</p>

@if (!Model.DiscoveryEnabled)
{
    <div class="notice">
        <strong>Discovery indisponível neste deployment.</strong> A solicitação de novas descobertas está
        desabilitada por configuração; o portal exibe apenas os resultados já registrados.
    </div>
}
else if (!Model.CanRequestDiscovery)
{
    <div class="notice">
        Você tem acesso de <strong>leitura</strong> aos resultados. Solicitar uma nova descoberta requer o
        papel <strong>Operator</strong> ou <strong>Administrator</strong>.
    </div>
}
else
{
    <div class="notice">
        Solicitar uma descoberta apenas <strong>descobre capacidades</strong> (READ-ONLY) de forma assíncrona:
        um Job durável é enfileirado e processado depois pelo Worker EV. <strong>Não executa Export-EVArchive
        e não exporta dados.</strong>
    </div>
}

@if (Model.Environments.Count == 0)
{
    <p class="empty">Nenhum ambiente Enterprise Vault neste tenant.</p>
}
else
{
    <div class="tablewrap">
        <table>
            <thead>
                <tr><th>Site</th><th>Directory Server</th><th>Resultado</th><th>Versão desc.</th><th>Adapter</th><th>Versão observada</th><th>Evidência (SHA-256)</th><th>Tamanho</th><th>Concluída (UTC)</th>@if (Model.CanRequestDiscovery){<th>Ação</th>}</tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Environments)
                {
                    var e = row.Summary;
                    <tr>
                        <td>@e.SiteName</td>
                        <td class="mono">@e.DirectoryServer</td>
                        @if (e.LatestDiscovery is { } disc)
                        {
                            <td><span class="@PillClass(disc.ResultStatus)">@disc.ResultStatus</span></td>
                            <td>v@disc.DiscoveryVersion</td>
                            <td>@(disc.SelectedAdapter ?? "—")@(disc.AdapterVersion is { } av ? $" (v{av})" : "")</td>
                            <td class="mono">@disc.ObservedVersion</td>
                            <td class="mono">@disc.EvidenceHash[..Math.Min(16, disc.EvidenceHash.Length)]…</td>
                            <td>@disc.EvidenceSizeBytes.ToString("N0") B</td>
                            <td class="mono">@disc.CompletedAtUtc.ToString("u")</td>
                        }
                        else
                        {
                            <td><span class="pill">sem descoberta</span></td>
                            <td>—</td><td>—</td><td>—</td><td>—</td><td>—</td><td>—</td>
                        }
                        @if (Model.CanRequestDiscovery)
                        {
                            <td>
                                <form method="post" asp-page-handler="RequestDiscovery">
                                    <input type="hidden" name="EnvironmentId" value="@e.EnvironmentId" />
                                    <input type="hidden" name="IdempotencyKey" value="@row.IdempotencyKey" />
                                    <button type="submit" class="btn">Executar discovery READ-ONLY</button>
                                </form>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.CanRequestDiscovery)
    {
        <p class="empty">
            Esta operação apenas descobre capacidades. Não executa Export-EVArchive e não exporta dados.
        </p>
    }
}
