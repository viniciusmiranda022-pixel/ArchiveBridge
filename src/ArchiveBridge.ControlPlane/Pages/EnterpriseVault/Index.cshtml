@page
@model ArchiveBridge.ControlPlane.Pages.EnterpriseVault.IndexModel
@{
    ViewData["Title"] = "Enterprise Vault";
    var header = new PageHeaderModel("Enterprise Vault", "Descoberta de capacidades e preparação do ambiente de origem. A descoberta é uma operação somente leitura — nenhum dado é exportado do Enterprise Vault.");
}

<partial name="_PageHeader" model="header" />

@if (Model.PresentationMode)
{
    <div class="alert warning">
        <span class="a-ico">@Icons.Svg("info")</span>
        <div class="a-body"><strong>Modo demonstração</strong>As ações de descoberta estão desabilitadas: os ambientes abaixo são exemplos sintéticos.</div>
    </div>
}
else if (!Model.DiscoveryEnabled)
{
    <div class="alert neutral">
        <span class="a-ico">@Icons.Svg("info")</span>
        <div class="a-body"><strong>Descoberta indisponível neste deployment.</strong>A solicitação de novas descobertas está desabilitada por configuração; o portal exibe apenas os resultados já registrados.</div>
    </div>
}
else if (!Model.CanRequestDiscovery)
{
    <div class="alert info">
        <span class="a-ico">@Icons.Svg("shield")</span>
        <div class="a-body"><strong>Acesso de leitura.</strong>Solicitar uma nova descoberta requer o papel Operator ou Administrator.</div>
    </div>
}
else
{
    <div class="alert info">
        <span class="a-ico">@Icons.Svg("shield")</span>
        <div class="a-body"><strong>Operação somente leitura.</strong>Solicitar uma descoberta apenas identifica capacidades do ambiente de origem de forma assíncrona (um job durável é enfileirado e processado depois). Nenhum dado é exportado do Enterprise Vault.</div>
    </div>
}

@if (Model.Environments.Count == 0)
{
    var empty = new EmptyStateModel(
        "Nenhuma descoberta executada",
        "Nenhum ambiente Enterprise Vault está associado a este projeto. Ambientes descobertos aparecerão aqui com seu resultado de capacidade e evidência.",
        "vault");
    <partial name="_EmptyState" model="empty" />
}
else
{
    <div class="card-grid">
        @foreach (var row in Model.Environments)
        {
            var e = row.Summary;
            var disc = e.LatestDiscovery;
            <div class="card">
                <div class="card-head">
                    <div>
                        <h3>@e.SiteName</h3>
                        <div class="card-sub mono">@e.DirectoryServer</div>
                    </div>
                    @if (disc is not null)
                    {
                        <partial name="_StatusBadge" model="disc.ResultStatus" />
                    }
                    else
                    {
                        <span class="badge neutral"><span class="dot"></span>Sem descoberta</span>
                    }
                </div>
                <div class="card-body">
                    @if (disc is not null)
                    {
                        <div class="kv">
                            <div><div class="k">Versão observada</div><div class="v mono">@disc.ObservedVersion</div></div>
                            <div><div class="k">Versão da descoberta</div><div class="v">v@(disc.DiscoveryVersion)</div></div>
                            <div><div class="k">Capability</div><div class="v">@(disc.SelectedAdapter ?? "—")@(disc.AdapterVersion is { } av ? $" (v{av})" : "")</div></div>
                            <div><div class="k">Última descoberta</div><div class="v mono">@DisplayFormat.Utc(disc.CompletedAtUtc)</div></div>
                        </div>
                        <details class="tech">
                            <summary>Detalhes técnicos</summary>
                            <div class="tech-body">
                                <div class="kv">
                                    <div><div class="k">Evidência (SHA-256)</div><div class="v"><partial name="_HashDisplay" model="@(new HashModel(disc.ContentSha256, 16))" /></div></div>
                                    <div><div class="k">Resultado</div><div class="v mono">@disc.ResultCode</div></div>
                                    <div><div class="k">Tamanho</div><div class="v">@disc.EvidenceSizeBytes.ToString("N0") bytes</div></div>
                                </div>
                            </div>
                        </details>
                    }
                    else
                    {
                        <p class="muted mt0">Ainda não há descoberta registrada para este ambiente.</p>
                    }
                </div>
                <div class="card-actions">
                    @if (disc is not null)
                    {
                        <a class="btn sm" asp-page="/Evidence/Index">@Icons.Svg("evidence") Ver Evidência</a>
                    }
                    @if (Model.CanRequestDiscovery)
                    {
                        <form method="post" asp-page-handler="RequestDiscovery" data-guard>
                            <input type="hidden" name="EnvironmentId" value="@e.EnvironmentId" />
                            <input type="hidden" name="IdempotencyKey" value="@row.IdempotencyKey" />
                            <button type="submit" class="btn sm primary" data-busy="Executando…">@Icons.Svg("search") Executar Discovery</button>
                        </form>
                    }
                    else if (Model.PresentationMode)
                    {
                        <button type="button" class="btn sm primary" disabled title="Operação desabilitada no modo demonstração">@Icons.Svg("search") Executar Discovery</button>
                    }
                </div>
            </div>
        }
    </div>
    @if (Model.PresentationMode)
    {
        <p class="faint">Operação desabilitada no modo demonstração.</p>
    }
}
