@page
@inject PresentationModeOptions Presentation
@inject IPresentationDataProvider Demo
@inject IControlPlaneQueries Queries
@inject IPortalScopeAccessor ScopeAccessor
@{
    ViewData["Title"] = "Ondas de Migração";
    var ct = HttpContext.RequestAborted;
    IReadOnlyList<WaveSummary> waves = Presentation.Enabled
        ? Demo.GetWaves()
        : await Queries.ListWavesAsync(ScopeAccessor.Resolve(User), 200, ct);
    var header = new PageHeaderModel("Ondas de Migração", "Cada onda agrupa os arquivos selecionados, sua capacidade planejada e o fluxo de aprovação e congelamento.");
}

<partial name="_PageHeader" model="header" />

@if (waves.Count == 0)
{
    var empty = new EmptyStateModel(
        "Nenhuma onda de migração",
        "Uma onda planeja um lote de arquivos para migração, com volume, itens e destino. As ondas do projeto aparecerão aqui.",
        "waves");
    <partial name="_EmptyState" model="empty" />
}
else
{
    <div class="tablewrap">
        <table class="data">
            <thead>
                <tr><th>Onda</th><th>Versão</th><th>Status</th><th>Volume</th><th>Itens</th><th>Aprovada por</th><th>Criada</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var wave in waves)
                {
                    <tr>
                        <td><b>@wave.Name</b></td>
                        <td>v@(wave.WaveVersion)</td>
                        <td><partial name="_StatusBadge" model="wave.Status" /></td>
                        <td class="num">@DisplayFormat.HumanBytes(wave.PlannedBytes)</td>
                        <td class="num">@wave.PlannedItems.ToString("N0")</td>
                        <td>@(wave.ApprovedBy ?? "—")</td>
                        <td class="mono nowrap">@DisplayFormat.Utc(wave.CreatedAtUtc)</td>
                        <td class="nowrap"><a class="btn sm" asp-page="/Waves/Details" asp-route-waveId="@wave.WaveId">Detalhes</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
