@page
@inject PresentationModeOptions Presentation
@inject IPresentationDataProvider Demo
@inject IControlPlaneQueries Queries
@inject IPortalScopeAccessor ScopeAccessor
@{
    ViewData["Title"] = "Jobs";
    var ct = HttpContext.RequestAborted;
    IReadOnlyList<JobSummary> jobs = Presentation.Enabled
        ? Demo.GetJobs()
        : await Queries.ListJobsAsync(ScopeAccessor.Resolve(User), 200, ct);

    int Count(string state) => jobs.Count(j => string.Equals(j.State, state, StringComparison.OrdinalIgnoreCase));
    var cards = new (string Label, string State, string Variant)[]
    {
        ("Pending", "Pending", "warning"),
        ("Processing", "Processing", "info"),
        ("Retry Scheduled", "RetryScheduled", "warning"),
        ("Completed", "Completed", "success"),
        ("Failed", "Failed", "danger"),
    };

    string StateLabel(string state) => state switch
    {
        "Processing" => "Em execução",
        "RetryScheduled" => "Nova tentativa agendada",
        "Failed" => "Falhou",
        "Completed" => "Concluído",
        "Pending" => "Pendente",
        _ => state,
    };
    var header = new PageHeaderModel("Jobs", "Jobs duráveis — fila de trabalho da plataforma. Cada job carrega estado, tentativas e a trilha imutável de transições.");
}

<partial name="_PageHeader" model="header" />

<div class="metrics">
    @foreach (var card in cards)
    {
        <div class="metric">
            <div class="top">
                <span class="label">@card.Label</span>
                <span class="badge @card.Variant"><span class="dot"></span>@Count(card.State)</span>
            </div>
            <div class="value">@Count(card.State)</div>
        </div>
    }
</div>

<h2 class="section">Fila de jobs</h2>
@if (jobs.Count == 0)
{
    var empty = new EmptyStateModel(
        "Nenhum Job em execução",
        "Os jobs duráveis processados pela plataforma (por exemplo, descoberta de capacidades) aparecerão aqui com seu estado e histórico.",
        "jobs");
    <partial name="_EmptyState" model="empty" />
}
else
{
    <div class="tablewrap">
        <table class="data">
            <thead>
                <tr><th>Job ID</th><th>Workload</th><th>Estado</th><th>Tentativa</th><th>Criado / Atualizado</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var job in jobs)
                {
                    <tr>
                        <td><a asp-page="/Jobs/Details" asp-route-jobId="@job.JobId" class="mono">@job.JobId.ToString()[..8]</a></td>
                        <td>@job.Workload</td>
                        <td>
                            <partial name="_StatusBadge" model="job.State" />
                            <div class="subtle">@StateLabel(job.State)</div>
                        </td>
                        <td>@job.AttemptCount</td>
                        <td class="mono nowrap">@DisplayFormat.Utc(job.UpdatedAtUtc)</td>
                        <td class="nowrap"><a class="btn sm" asp-page="/Jobs/Details" asp-route-jobId="@job.JobId">Detalhes</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
