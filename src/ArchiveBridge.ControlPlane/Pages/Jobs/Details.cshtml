@page
@inject PresentationModeOptions Presentation
@inject IPresentationDataProvider Demo
@inject IControlPlaneQueries Queries
@inject IPortalScopeAccessor ScopeAccessor
@{
    ViewData["Title"] = "Job";
    var ct = HttpContext.RequestAborted;
    Guid.TryParse(Request.Query["jobId"].ToString(), out var jobId);

    JobSummary? job;
    IReadOnlyList<JobTransitionView> transitions;
    if (Presentation.Enabled)
    {
        job = jobId == Guid.Empty ? null : Demo.GetJobs().FirstOrDefault(j => j.JobId == jobId);
        transitions = jobId == Guid.Empty ? [] : Demo.GetJobTransitions(jobId);
    }
    else
    {
        var scope = ScopeAccessor.Resolve(User);
        job = jobId == Guid.Empty ? null : (await Queries.ListJobsAsync(scope, 200, ct)).FirstOrDefault(j => j.JobId == jobId);
        transitions = jobId == Guid.Empty ? [] : await Queries.ListJobTransitionsAsync(scope, jobId, ct);
    }

    var latestLease = transitions.Count > 0 ? transitions[^1].LeaseEpoch.ToString(System.Globalization.CultureInfo.InvariantCulture) : "—";
}

<p><a class="btn sm ghost" asp-page="/Jobs/Index">@Icons.Svg("arrow-left") Jobs</a></p>

@if (job is null && transitions.Count == 0)
{
    var empty = new EmptyStateModel(
        "Job não encontrado",
        "O job solicitado não existe neste escopo ou você não tem permissão para visualizá-lo.",
        "jobs");
    <partial name="_EmptyState" model="empty" />
}
else
{
    <div class="page-head">
        <div class="titles">
            <h1>Job @(jobId.ToString()[..8])</h1>
            <p class="sub">Fila durável · trilha imutável de transições de estado (ordem cronológica).</p>
        </div>
        @if (job is not null)
        {
            <div class="head-actions"><partial name="_StatusBadge" model="job.State" /></div>
        }
    </div>

    <div class="grid-2">
        <div class="card">
            <div class="card-head"><h3>Resumo</h3></div>
            <div class="card-body">
                <div class="kv">
                    <div><div class="k">Job ID</div><div class="v mono">@jobId</div></div>
                    <div><div class="k">Workload</div><div class="v">@(job?.Workload ?? "—")</div></div>
                    <div><div class="k">Estado</div><div class="v">@if (job is not null) { <partial name="_StatusBadge" model="job.State" /> } else { <span>—</span> }</div></div>
                    <div><div class="k">Tentativa</div><div class="v">@(job?.AttemptCount.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "—")</div></div>
                    <div><div class="k">Época do lease</div><div class="v mono">@latestLease</div></div>
                    <div><div class="k">Último erro</div><div class="v">@(job?.LastErrorCode ?? "—")</div></div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-head"><h3>Linha do tempo</h3></div>
            <div class="card-body">
                @if (transitions.Count == 0)
                {
                    <p class="muted mt0">Sem transições visíveis para este job neste escopo.</p>
                }
                else
                {
                    <ul class="timeline">
                        @for (var i = 0; i < transitions.Count; i++)
                        {
                            var t = transitions[i];
                            var cls = i == transitions.Count - 1 ? "active" : "done";
                            <li class="@cls">
                                <span class="tdot"></span>
                                <div class="tname">@t.ToState</div>
                                <div class="tmeta">@t.ReasonCode · @DisplayFormat.Utc(t.OccurredAtUtc)@(t.WorkerId is null ? "" : $" · {t.WorkerId}")</div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
}
