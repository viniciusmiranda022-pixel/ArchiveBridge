@page
@model ArchiveBridge.ControlPlane.Pages.Jobs.DetailsModel
@{
    ViewData["Title"] = "Job";
    var job = Model.Job;
    var transitions = Model.Transitions;
    var jobId = Model.JobIdValue;
    var latestLease = transitions.Count > 0 ? transitions[^1].LeaseEpoch.ToString(System.Globalization.CultureInfo.InvariantCulture) : "—";
}

<p><a class="btn sm ghost" asp-page="/Jobs/Index">@Icons.Svg("arrow-left") Jobs</a></p>

@if (job is null && transitions.Count == 0)
{
    var empty = new EmptyStateModel(
        "Job não encontrado",
        "O job solicitado não existe neste escopo ou você não tem permissão para visualizá-lo.",
        "jobs");
    <partial name="_EmptyState" model="empty" />
}
else
{
    <div class="page-head">
        <div class="titles">
            <h1>Job @(jobId.ToString()[..8])</h1>
            <p class="sub">Fila durável · trilha imutável de transições de estado (ordem cronológica).</p>
        </div>
        @if (job is not null)
        {
            <div class="head-actions"><partial name="_StatusBadge" model="job.State" /></div>
        }
    </div>

    @if (Model.PresentationMode && job is not null && job.State == nameof(ArchiveBridge.Domain.Jobs.JobState.RetryScheduled))
    {
        <div class="alert warning">
            <span class="a-ico">@Icons.Svg("info")</span>
            <div class="a-body"><strong>Modo demonstração</strong>O retry manual está desabilitado: este job é um exemplo sintético.</div>
        </div>
    }
    else if (!Model.PresentationMode && job is not null && job.State == nameof(ArchiveBridge.Domain.Jobs.JobState.RetryScheduled))
    {
        if (!Model.RetryEnabled)
        {
            <div class="alert neutral">
                <span class="a-ico">@Icons.Svg("info")</span>
                <div class="a-body"><strong>Retry manual indisponível neste deployment.</strong>A solicitação de retry está desabilitada por configuração; a nova tentativa ainda ocorrerá automaticamente no horário agendado.</div>
            </div>
        }
        else if (!Model.IsRetryOperator)
        {
            <div class="alert info">
                <span class="a-ico">@Icons.Svg("shield")</span>
                <div class="a-body"><strong>Acesso de leitura.</strong>Solicitar retry manual requer o papel Operator ou Administrator.</div>
            </div>
        }
        else
        {
            <div class="alert info">
                <span class="a-ico">@Icons.Svg("shield")</span>
                <div class="a-body"><strong>Retry autorizado e idempotente.</strong>Adianta a próxima tentativa já agendada pelo domínio para agora. Não força nenhuma transição de estado nem reexecuta efeitos externos.</div>
            </div>
        }
    }

    <div class="grid-2">
        <div class="card">
            <div class="card-head"><h3>Resumo</h3></div>
            <div class="card-body">
                <div class="kv">
                    <div><div class="k">Workload</div><div class="v">@(job?.Workload ?? "—")</div></div>
                    <div><div class="k">Estado</div><div class="v">@if (job is not null) { <partial name="_StatusBadge" model="job.State" /> } else { <span>—</span> }</div></div>
                    <div><div class="k">Tentativa</div><div class="v">@(job?.AttemptCount.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "—")</div></div>
                    <div><div class="k">Último resultado</div><div class="v">@(job?.LastErrorCode ?? "—")</div></div>
                </div>
                <details class="tech">
                    <summary>Detalhes técnicos</summary>
                    <div class="tech-body">
                        <div class="kv">
                            <div><div class="k">Job ID</div><div class="v mono">@jobId</div></div>
                            <div><div class="k">Época do lease</div><div class="v mono">@latestLease</div></div>
                        </div>
                    </div>
                </details>
                @if (job is not null && job.State == nameof(ArchiveBridge.Domain.Jobs.JobState.RetryScheduled))
                {
                    <div class="card-actions">
                        @if (Model.CanRequestRetry)
                        {
                            <form method="post" asp-page-handler="Retry" data-guard>
                                <input type="hidden" name="jobId" value="@jobId" />
                                <input type="hidden" name="idempotencyKey" value="@Model.IdempotencyKey" />
                                <button type="submit" class="btn sm primary" data-busy="Solicitando…">@Icons.Svg("retry") Retry agora</button>
                            </form>
                        }
                        else if (Model.PresentationMode)
                        {
                            <button type="button" class="btn sm primary" disabled title="Operação desabilitada no modo demonstração">@Icons.Svg("retry") Retry agora</button>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-head"><h3>Linha do tempo</h3></div>
            <div class="card-body">
                @if (transitions.Count == 0)
                {
                    <p class="muted mt0">Sem transições visíveis para este job neste escopo.</p>
                }
                else
                {
                    <ul class="timeline">
                        @for (var i = 0; i < transitions.Count; i++)
                        {
                            var t = transitions[i];
                            var cls = i == transitions.Count - 1 ? "active" : "done";
                            <li class="@cls">
                                <span class="tdot"></span>
                                <div class="tname">@t.ToState</div>
                                <div class="tmeta">@t.ReasonCode · @DisplayFormat.Utc(t.OccurredAtUtc)@(t.WorkerId is null ? "" : $" · {t.WorkerId}")</div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
}
