@page
@model ArchiveBridge.ControlPlane.Pages.Audit.IndexModel
@{
    ViewData["Title"] = "Auditoria";
    var header = new PageHeaderModel("Auditoria", "Trilha de auditoria imutável: eventos operacionais deste projeto e tentativas de autenticação deste tenant. Visualizar ou filtrar é somente leitura — não gera nenhum evento.");
}

<partial name="_PageHeader" model="header" />

<div data-tabs>
    <div class="tabs" role="tablist">
        <button class="tab active" data-tab="ops" type="button">Eventos Operacionais</button>
        <button class="tab" data-tab="auth" type="button">Autenticação</button>
    </div>

    <div class="tabpanel active" data-panel="ops">
        <form method="get" class="filters">
            <div class="field">
                <label for="opAction">Ação</label>
                <input id="opAction" name="opAction" value="@Model.OpAction" maxlength="64" autocomplete="off" />
            </div>
            <div class="field">
                <label for="opUsername">Usuário (prefixo)</label>
                <input id="opUsername" name="opUsername" value="@Model.OpUsername" maxlength="200" autocomplete="off" />
            </div>
            <div class="field">
                <label for="opSucceeded">Resultado</label>
                <select id="opSucceeded" name="opSucceeded">
                    <option value="">Todos</option>
                    <option value="true" selected="@(Model.OpSucceeded == "true")">Sucesso</option>
                    <option value="false" selected="@(Model.OpSucceeded == "false")">Falha</option>
                </select>
            </div>
            <div class="field">
                <label for="opCorrelation">Correlação</label>
                <input id="opCorrelation" name="opCorrelation" value="@Model.OpCorrelation" autocomplete="off" />
            </div>
            <div class="field">
                <label for="opFrom">De (UTC)</label>
                <input id="opFrom" name="opFrom" value="@Model.OpFrom" placeholder="AAAA-MM-DDTHH:MM" autocomplete="off" />
            </div>
            <div class="field">
                <label for="opTo">Até (UTC)</label>
                <input id="opTo" name="opTo" value="@Model.OpTo" placeholder="AAAA-MM-DDTHH:MM" autocomplete="off" />
            </div>
            <div class="field">
                <label for="opSize">Quantidade</label>
                <select id="opSize" name="opSize">
                    @foreach (var size in new[] { 25, 50, 100 })
                    {
                        <option value="@size" selected="@(Model.OpPageSize == size)">@size</option>
                    }
                </select>
            </div>
            @if (Model.AuthUsername is not null) { <input type="hidden" name="authUsername" value="@Model.AuthUsername" /> }
            @if (Model.AuthSucceeded is not null) { <input type="hidden" name="authSucceeded" value="@Model.AuthSucceeded" /> }
            @if (Model.AuthReason is not null) { <input type="hidden" name="authReason" value="@Model.AuthReason" /> }
            @if (Model.AuthFrom is not null) { <input type="hidden" name="authFrom" value="@Model.AuthFrom" /> }
            @if (Model.AuthTo is not null) { <input type="hidden" name="authTo" value="@Model.AuthTo" /> }
            @if (Model.AuthCursor is not null) { <input type="hidden" name="authCursor" value="@Model.AuthCursor" /> }
            <input type="hidden" name="authSize" value="@Model.AuthPageSize" />
            <div class="field actions">
                <button type="submit" class="btn primary">@Icons.Svg("search") Filtrar</button>
                <a class="btn" asp-page="/Audit/Index">Limpar</a>
            </div>
        </form>

        @if (Model.Operations.Count == 0)
        {
            var empty = new EmptyStateModel("Nenhum evento operacional", "As ações operacionais realizadas na plataforma, com usuário, recurso e correlação, aparecerão aqui.", "audit");
            <partial name="_EmptyState" model="empty" />
        }
        else
        {
            <div class="tablewrap">
                <table class="data">
                    <thead>
                        <tr><th>Data/Hora (UTC)</th><th>Usuário</th><th>Ação</th><th>Recurso</th><th>Resultado</th><th>Motivo</th><th>Correlação</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var e in Model.Operations)
                        {
                            <tr>
                                <td class="mono nowrap">@DisplayFormat.Utc(e.OccurredAtUtc)</td>
                                <td>@e.Username</td>
                                <td class="mono">@e.ActionCode</td>
                                <td class="mono">@e.ResourceType/@e.ResourceId</td>
                                <td>@if (e.Succeeded) { <span class="badge success"><span class="dot"></span>Sucesso</span> } else { <span class="badge danger"><span class="dot"></span>Negado</span> }</td>
                                <td>@e.Reason</td>
                                <td class="mono">@e.CorrelationId.ToString()[..8]…</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="pager">
                <span class="count">Mostrando até @Model.OpPageSize registros.</span>
                @if (Model.OperationsHasMore)
                {
                    <a class="btn sm" asp-page="/Audit/Index" asp-all-route-data="@Model.OperationsNextRoute">Próxima →</a>
                }
            </div>
        }
    </div>

    <div class="tabpanel" data-panel="auth">
        <form method="get" class="filters">
            <div class="field">
                <label for="authUsername">Usuário (prefixo)</label>
                <input id="authUsername" name="authUsername" value="@Model.AuthUsername" maxlength="200" autocomplete="off" />
            </div>
            <div class="field">
                <label for="authSucceeded">Resultado</label>
                <select id="authSucceeded" name="authSucceeded">
                    <option value="">Todos</option>
                    <option value="true" selected="@(Model.AuthSucceeded == "true")">Sucesso</option>
                    <option value="false" selected="@(Model.AuthSucceeded == "false")">Falha</option>
                </select>
            </div>
            <div class="field">
                <label for="authReason">Motivo</label>
                <input id="authReason" name="authReason" value="@Model.AuthReason" maxlength="100" autocomplete="off" />
            </div>
            <div class="field">
                <label for="authFrom">De (UTC)</label>
                <input id="authFrom" name="authFrom" value="@Model.AuthFrom" placeholder="AAAA-MM-DDTHH:MM" autocomplete="off" />
            </div>
            <div class="field">
                <label for="authTo">Até (UTC)</label>
                <input id="authTo" name="authTo" value="@Model.AuthTo" placeholder="AAAA-MM-DDTHH:MM" autocomplete="off" />
            </div>
            <div class="field">
                <label for="authSize">Quantidade</label>
                <select id="authSize" name="authSize">
                    @foreach (var size in new[] { 25, 50, 100 })
                    {
                        <option value="@size" selected="@(Model.AuthPageSize == size)">@size</option>
                    }
                </select>
            </div>
            @if (Model.OpAction is not null) { <input type="hidden" name="opAction" value="@Model.OpAction" /> }
            @if (Model.OpUsername is not null) { <input type="hidden" name="opUsername" value="@Model.OpUsername" /> }
            @if (Model.OpSucceeded is not null) { <input type="hidden" name="opSucceeded" value="@Model.OpSucceeded" /> }
            @if (Model.OpCorrelation is not null) { <input type="hidden" name="opCorrelation" value="@Model.OpCorrelation" /> }
            @if (Model.OpFrom is not null) { <input type="hidden" name="opFrom" value="@Model.OpFrom" /> }
            @if (Model.OpTo is not null) { <input type="hidden" name="opTo" value="@Model.OpTo" /> }
            @if (Model.OpCursor is not null) { <input type="hidden" name="opCursor" value="@Model.OpCursor" /> }
            <input type="hidden" name="opSize" value="@Model.OpPageSize" />
            <div class="field actions">
                <button type="submit" class="btn primary">@Icons.Svg("search") Filtrar</button>
                <a class="btn" asp-page="/Audit/Index">Limpar</a>
            </div>
        </form>

        @if (Model.SignIns.Count == 0)
        {
            var empty = new EmptyStateModel("Nenhum evento de autenticação", "As tentativas de login deste tenant, com resultado e origem, aparecerão aqui.", "shield");
            <partial name="_EmptyState" model="empty" />
        }
        else
        {
            <div class="tablewrap">
                <table class="data">
                    <thead>
                        <tr><th>Data/Hora (UTC)</th><th>Usuário</th><th>Resultado</th><th>Motivo</th><th>Origem</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var e in Model.SignIns)
                        {
                            <tr>
                                <td class="mono nowrap">@DisplayFormat.Utc(e.OccurredAtUtc)</td>
                                <td>@e.Username</td>
                                <td>@if (e.Succeeded) { <span class="badge success"><span class="dot"></span>Sucesso</span> } else { <span class="badge danger"><span class="dot"></span>Falha</span> }</td>
                                <td>@e.Reason</td>
                                <td class="mono">@(e.RemoteAddress ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="pager">
                <span class="count">Mostrando até @Model.AuthPageSize registros.</span>
                @if (Model.SignInsHasMore)
                {
                    <a class="btn sm" asp-page="/Audit/Index" asp-all-route-data="@Model.SignInsNextRoute">Próxima →</a>
                }
            </div>
        }
    </div>
</div>
